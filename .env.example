# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Catalog database (provided Альфа-Курс PostgreSQL dump).
# With docker compose this is set automatically to the `db` service and you do
# NOT need to edit it. For a standalone/local run point it at your PostgreSQL:
#   DATABASE_URL=postgresql://alfa:alfa@localhost:5432/alfa_course
# If unset or not a postgres:// URL, the backend serves its demo catalog.
# DATABASE_URL=

# Ranking strategy forwarded to the recommender engine: baseline | hybrid
RECO_STRATEGY=baseline

# Add external service keys only if actually required.
# NEVER put real secrets in this file.
